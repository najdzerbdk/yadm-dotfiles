# vim:ft=kitty

# Potwierdź zamknięcie okna, jeśli w środku działa jakiś proces.
confirm_os_window_close 0

# Ustawienia układu okien. Używa układu 'tall' i domyślnie 'tabs'.
enabled_layouts tall,*
window_padding_width 5

# Integracja z powłoką
shell_integration no-cursor
shell /usr/bin/fish

# Ustawienia scrollback
scrollback_pager less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER
scrollback_indicator_opacity 1.0
scrollback_lines 2000

# Ustawienia kursora
cursor_trail 1
cursor_shape beam
cursor_beam_thickness 2
cursor_shape_unfocused unchanged
cursor_blink_interval -1 ease-in-out

# Ustawienia paska zakładek
tab_bar_style powerline

# Ustawienia przezroczystości tła
background_opacity 0.90
dynamic_background_opacity no
background_blur 1

# Ustawienia fontów
font_family 0xProto Nerd Font
bold_font auto
italic_font auto
bold_italic_font auto
font_size 12

# Włączanie motywu
include /home/najdza/.config/btop/themes/matugen.theme

# Skróty klawiszowe
map ctrl+v paste_from_clipboard
map ctrl+k delete_to_end_of_line
map ctrl+u delete_to_beginning_of_line
