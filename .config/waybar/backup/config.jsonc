{
  "height": 40,
  "spacing": 10,
  "swap-icon-label": true,
  "modules-left": [
    "group/workspaces",
    "custom/player2"
  ],
  "modules-center": [
    "group/windows"
  ],
  "modules-right": [
    "group/system",
    "wireplumber",
  ],

  // ====================
  // Custom Modules
  // ====================
  "custom/openbracket": {
    "format": "[",
    "tooltip": false
  },
  "custom/closebracket": {
    "format": "]",
    "tooltip": false
  },
  "custom/split": {
    "format": "|",
    "tooltip": false
  },
  "custom/space": {
    "format": "   ",
    "tooltip": false
  },
  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },
  "custom/powerprofile": {
    "exec": "~/.config/waybar/scripts/powerprofile.sh display",
    "on-click": "~/.config/waybar/scripts/powerprofile.sh toggle",
    "interval": 5,
    "tooltip": true,
    "exec-tooltip": "~/.config/waybar/scripts/powerprofile.sh tooltip",
    "tooltip-format": "Power Profile: {} \nClick to cycle: Efficient → Normal → Overclocked"
  },
  "custom/themeswitcher": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Click to change theme",
    "on-click": "~/.config/waybar/scripts/theme-switcher.sh next",
    "on-click-right": "~/.config/scripts/theme-switcher.sh random"
  },
  "custom/player2": {
    "exec": "~/.config/waybar/scripts/player_waybar.sh",
    "interval": 2,
    "on-click": "bash ~/.config/waybar/scripts/player_waybar.sh toggle",
    "tooltip": false
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span font-size='large'>{icon}</span>",
    "format-icons": {
      "notification": " ",
      "none": " ",
      "dnd-notification": " ",
      "dnd-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-middle": "swaync-client -C",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/spotify": {
    "exec": "/usr/bin/python3 /home/najdza/.config/waybar/scripts/mediaplayer.py",
    "format": "{}  ",
    "return-type": "json",
    "on-click": "playerctl --player=spotify play-pause",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous"
  },
  "custom/bluetooth": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/bluetooth_status.sh",
    "interval": 5,
    "on-click": "blueman-manager"
  },
  "custom/player": {
    "exec": "~/.config/waybar/scripts/player_waybar.sh",
    "interval": 2,
    "on-click": "bash ~/.config/waybar/scripts/player_waybar.sh toggle",
    "tooltip": false
  },
  "custom/brave": {
    "exec": "/home/najdza/.config/waybar/scripts/waybar_brave_player.sh",
    "interval": 2,
    "tooltip": false,
    "on-click": "playerctl -p brave play-pause"
  },
  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava_wrapper.sh",
    "format": "♪ {}",
    "restart-interval": 1,
    "max-length": 50,
    "on-click": "pkill cava"
  },

  // ====================
  // Groups
  // ====================
  "group/workspaces": {
    "orientation": "horizontal",
    "spacing": 5,
    "modules": ["hyprland/workspaces"]
  },
  "group/windows": {
    "orientation": "horizontal",
    "spacing": 5,
    "modules": ["hyprland/window"]
  },
  "group/cpuram": {
    "orientation": "horizontal",
    "spacing": 8,
    "modules": ["cpu", "custom/space", "memory"]
  },
  "group/system": {
    "orientation": "horizontal",
    "spacing": 5,
    "modules": ["clock"]
  },

  // ====================
  // Hyprland Modules
  // ====================
"hyprland/workspaces": {
    "all-outputs": true,
    "warp-on-scroll": false,
    "enable-bar-scroll": true,
    "disable-scroll-wraparound": true,
    "active-only": false,
    "format": "{icon}",
    "format-focused": "<span color='#957fb8'><b>{icon}</b></span>",
    "persistent-workspaces": { "*": [1, 2, 3] },
    "format-icons": { "1": "1", "2": "2", "3": "3", "default": "•" }
}

  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "min-length": 20,
    "all-outputs": true
  },

  // ====================
  // CPU/RAM
  // ====================
  "cpu": {
    "format": "CPU:{usage}%",
    "tooltip": false,
    "interval": 2,
    "on-click": "konsole -e btop"
  },
  "memory": {
    "format": "RAM:{}%",
    "tooltip": false,
    "interval": 2,
    "on-click": "konsole -e btop"
  },
  "custom/gammastep": {
    "format": "🌗 ", 
    "tooltip": true,
    "tooltip-format": "Toggle gammastep",
    "on-click": "gammastep toggle"
},


  // ====================
  // Clock
  // ====================
  "clock": {
    "format": "{:%R}  ",
    "tooltip-format": "{calendar}",
    "calendar": {
      "format": {
        "months": "<span color='#D3D04F'><b>{}</b></span>",
        "days": "<span color='#93B1A6'><b>{}</b></span>",
        "weekdays": "<span color='#8EAC50'><b>{}</b></span>",
        "today": "<span color='#8EAC50'><b><u>{}</u></b></span>"
      }
    }
  },

  // ====================
  // Audio
  // ====================
  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon}{volume}% ",
    "format-bluetooth": "{icon} {volume}%  ",
    "format-bluetooth-muted": " {icon}",
    "format-muted": " 0%",
    "format-icons": { "default": [" ", " ", " "] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " Muted",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%-",
    "scroll-step": 5
  },

  // ====================
  // Tray
  // ====================
  "tray": {
    "icon-size": 13,
    "spacing": 5
  }
}
